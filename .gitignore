# The SMT-LIB logics were nine submodules of clc-gitlab.cs.uiowa.edu:2443 until 2026-09-14.
# None was ever checked out, that port stopped answering, and SMT-LIB moved to per-logic Zenodo
# archives, which a submodule cannot point at; a copy downloaded from there goes in these paths.
# QF_CDT is NOT here: it is tracked, and that logic no longer exists in SMT-LIB.
benchmarks/SMT/QF_ALIA/
benchmarks/SMT/QF_DT/
benchmarks/SMT/QF_LIA/
benchmarks/SMT/QF_LIRA/
benchmarks/SMT/QF_LRA/
benchmarks/SMT/QF_NIA/
benchmarks/SMT/QF_NIRA/
benchmarks/SMT/QF_NRA/
benchmarks/SMT/QF_UF/
# Corpora placed by script/fetch_benchmarks.sh from a pinned archive or a submodule, at the path
# this tree's scripts and configurations read (script/fetch/<name>.manifest lists each file).
benchmarks/SyGuS/pcsat_rl/
benchmarks/sygus-comp19-inv/compare/
benchmarks/QSMT/LRA/
benchmarks/QSMT/LIA/
benchmarks/QSMT/cav2024/
benchmarks/LTS/tacas2014/
benchmarks/C/cav2018term/
benchmarks/C/fse2022/
benchmarks/CHC/ADTs/ADTRem-benchmarks/
benchmarks/C/cav2015ltl/
benchmarks/LTS/ltlverp/
benchmarks/C/ltlverp/
benchmarks/CHC/ADTs/ADTRem-JLC-benchmarks/
benchmarks/SAT/sc2016/
benchmarks/HORS/koba/
benchmarks/HORS/koba2/
benchmarks/muCLP/popl2024/
# Others' git repositories fetched as clones at a pinned commit (script/fetch_benchmarks.sh dqbf-sic
# synthetic-qbf); the clone's commit is what --verify checks.
benchmarks/QSAT/DQBFbenchmarks/
benchmarks/QSAT/synthetic_qbf_formulas/
benchmarks/OCaml/recheck/
# Sprout(A)'s protocols, streamed out of its artifact's Docker image (script/fetch_benchmarks.sh sprouta).
/benchmarks/sprouta/
/benchmarks/sprouta.partial/
# HyHorn's sources and suite, streamed out of its ESOP'24 artifact's Docker image (script/fetch_benchmarks.sh hyhorn).
/benchmarks/hyhorn/
/benchmarks/hyhorn.partial/

# Corpora generated from a submodule's sources by an encoder rather than downloaded:
# script/gen_sprout_hes.sh (benchmarks/sprout) and script/gen_issy_hes.py
# (benchmarks/infinite-state-reactive-synthesis-benchmarks).
/benchmarks/sprout-generated/
# script/gen_sprouta_hes.sh (benchmarks/sprouta, fetched)
/benchmarks/sprouta-generated/
# script/hyhorn_to_pcsp.py (benchmarks/hyhorn, fetched)
/benchmarks/hyhorn-pcsp/
benchmarks/muCLP/issy/
# script/gen_rg_games.py (SimSat's reachability games, benchmarks/QSMT/ijcai2016/test/reachability)
benchmarks/muCLP/rg_games/
benchmarks/ECHC/rg_games/
benchmarks/UCHC/rg_games/

# The HSF/QARMC archive beside the two hand-written E-CHC probes.  It is the
# provenance evidence for that corpus and is kept in the working tree on
# purpose, untracked: this repository is against a size limit and the archive
# is 12.7 MB of .qarmc files no tool here reads.  It was added by accident on
# 2026-09-22 by a `git add -A <dir>` and removed again; the entry is here so
# the next one cannot.
benchmarks/ECHC/hsf-Benchmarks.zip
# Generated from that archive by script/gen_ehsf_echc.py (script/qarmc_to_smt2.py), each file in
# the corpus of its least class; never tracked, since the archive's licence is not stated.
benchmarks/ECHC/ehsf/
benchmarks/pfwnCSP/ehsf/
benchmarks/CHC/ehsf/
benchmarks/muCLP/ehsf/
# ConSynth's .qarmc inputs fetched by script/gen_ehsf_echc.py --fetch (gensys @ 1c80c45f, no licence stated).
benchmarks/ECHC/consynth-src/
benchmarks/pCSP/rethfl/
benchmarks/HFL/fetched/
# generated by script/gen_rethfl_pcsp.sh (script/fetch_benchmarks.sh rethfl-aplas2020)
benchmarks/pCSP/rethfl-aplas2020/
# generated by script/gen_linear_arbitrary_chc.sh (script/fetch_benchmarks.sh linarb-regen)
benchmarks/CHC/LinearArbitrary_regen2026/
# generated by script/gen_termcomp_t2.sh (script/fetch_benchmarks.sh termcomp-t2)
benchmarks/LTS/term-comp_llvm2lts/
