# x and y are nat variables, so y := x / 2 is integer division: y is 5 / 2 = 2, and the
# lower bound 5/2 on its expectation does not hold.
# Expected: unknown (the bound is false; the bound checker never refutes).  Read with every
# variable a real, y was 2.5 and the bound was proved valid.
nat x;
nat y;
x := 5;
y := x / 2;
?Ex [y] >= 2.5
