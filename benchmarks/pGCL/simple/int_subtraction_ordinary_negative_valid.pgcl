# x and y are int variables, ordinary integers of either sign, so subtraction on them is
# ordinary: y := x - 2 at x = 1 makes y = -1, and y = -1 holds with probability 1.  (The
# post is an indicator because an expectation must be non-negative in every state.)
# Expected: valid.  Declared nat, the subtraction is monus and y is 0; before pGCL had an int
# declaration this file did not parse.
int x;
int y;
x := 1;
y := x - 2;
?Ex [[y = 0 - 1]] >= 1
