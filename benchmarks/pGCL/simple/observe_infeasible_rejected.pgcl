# Every run is blocked by the observation, so the program is infeasible: wlp(S, 1) = 0 and
# the conditional expectation is undefined.
# Expected: refused as infeasible, never answered.  The reduced query wp_1(S, c) <= 1 holds
# vacuously (1 <= 1), and the unnormalised reading answered every bound >= 0 valid.
nat c;
c := 1;
observe(c = 0);
?Ex [c] <= 1
