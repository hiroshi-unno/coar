# x and y are nat variables, so y := x - 2 is truncated subtraction (monus): y is
# max(1 - 2, 0) = 0, and the lower bound 0 on its expectation holds.
# Expected: valid.  Read as ordinary subtraction, y was -1, a value no nat holds, and the
# bound was not proved.
nat x;
nat y;
x := 1;
y := x - 2;
?Ex [y] >= 0
