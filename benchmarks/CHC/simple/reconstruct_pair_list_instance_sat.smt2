(set-logic HORN)
(declare-datatypes ( (Pair 2) ) ( (par (T1 T2) ( (mk-pair (first T1) (second T2)) )) ))
(declare-fun incorrect () Bool)
(declare-fun zip ( (List Int) (List Int) (List (Pair Int Int)) ) Bool)
(assert (forall ( (B (List Int)) ) (zip nil B nil)))
(assert (forall ( (A Int) (B (List Int)) ) (zip (insert A B) nil nil)))
(assert (forall ( (A Int) (B Int) (X (List Int)) (Y (List Int)) (Z (List (Pair Int Int))) )
  (=> (zip X Y Z) (zip (insert A X) (insert B Y) (insert (mk-pair A B) Z)))))
(assert (forall ( (A (List Int)) (B (List (Pair Int Int))) )
  (=> (and (zip nil A B) (not (= B nil))) incorrect)))
(assert (=> incorrect false))
(check-sat)
