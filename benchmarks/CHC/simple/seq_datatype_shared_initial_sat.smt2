(set-logic HORN)
(declare-datatypes ((Apple 0) (Axe 0)) (((ap1) (ap2)) ((ax1) (ax2))))
(declare-fun P ((Seq Apple) Int) Bool)
(declare-fun Q ((Seq Axe) Int) Bool)
(assert (forall ((s (Seq Apple)) (n Int)) (=> (and (= s (as seq.empty (Seq Apple))) (= n 0)) (P s n))))
(assert (forall ((s (Seq Apple)) (n Int) (a Apple)) (=> (and (P s n) (= a ap1)) (P (seq.++ s (seq.unit a)) (+ n 1)))))
(assert (forall ((t (Seq Axe)) (m Int)) (=> (and (= t (as seq.empty (Seq Axe))) (= m 0)) (Q t m))))
(assert (forall ((t (Seq Axe)) (m Int) (b Axe)) (=> (and (Q t m) (= b ax2)) (Q (seq.++ t (seq.unit b)) (+ m 1)))))
(assert (forall ((s (Seq Apple)) (n Int) (t (Seq Axe)) (m Int)) (=> (and (P s n) (Q t m) (= n m)) (= (seq.len s) (seq.len t)))))
(assert (forall ((s (Seq Apple)) (n Int)) (=> (and (P s n) (> n 0)) (= (seq.nth s (- n 1)) ap1))))
(assert (forall ((t (Seq Axe)) (m Int)) (=> (and (Q t m) (> m 0)) (= (seq.nth t (- m 1)) ax2))))
(check-sat)
