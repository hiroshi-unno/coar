(declare-fun P (Idx) Bool)
(declare-fun Q ((Pair Int)) Bool)
(assert (forall ((i Idx)) (=> (> i 0) (P i))))
(assert (forall ((i Idx)) (=> (and (P i) (<= i 0)) false)))
(assert (forall ((a (Pair Int))) (=> (= (select a 0) 1) (Q a))))
