(format LCTRS)
(theory Ints)

(fun l0 (-> Int Int Int))
(fun l1 (-> Int Int Int))
(fun l2 (-> Int Int Int))

(entrypoint l0)

(rule
  (l0 x y)
  (l1 x_post y_post)
  :guard
  (and
    (= x_post x)
    (= y_post y)))

(rule
  (l1 x y)
  (l1 x_post y_post)
  :guard
  (and
    (>= x 0)
    (= x_post (+ x y))
    (= y_post (- y 1))))

(rule
  (l1 x y)
  (l2 x_post y_post)
  :guard
  (and
    (< x 0)
    (= x_post x)
    (= y_post y)))