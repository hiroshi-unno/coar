_forall f : (bool -> bool) -> bool. _exists i : bool -> bool. _exists c : bool -> bool.
(
    (* i is the identity and c the constant false: they agree at false and differ at true *)
    (_forall z : bool. ((i(z) <=> z()) && not (c(z)))) &&
    (* false for f = fun h -> h(true), which tells them apart *)
    not (f(i) && not (f(c)))
)
