/* As semgus_unreified_inc_dec_spec_valid.hes with a wrong specification (adds 3). */
(declare-datatypes ((Prog 0)) (((Nil) (Inc (inext Prog)) (Dec (dnext Prog)))))
forall (x: int) (y: int). Sem (Inc (Inc (Dec (Inc Nil)))) x y => y = x + 3
s.t.
Sem (p: Prog) (x: int) (y: int) : bool =mu (p = Nil /\ y = x) \/ (exists (q: Prog). p = (Inc q) /\ Sem q (x + 1) y) \/ (exists (q: Prog). p = (Dec q) /\ Sem q (x - 1) y);
