%BEGING
Reverse x = RevAcc x e.
RevAcc x z =
 case x of e => z
   | a y => RevAcc y (a z)
   | b y => RevAcc y (b z).
%ENDG

%BEGINA
/* q0 : a*b*e */
q0 a -> q0. q0 e -> . q0 b -> q1.
q1 b -> q1. q1 e -> .
/* q2 : b*a*e */
q2 b -> q2. q2 e -> . q2 a -> q3. q3 a -> q3. q3 e -> .
%ENDA

%BEGINT
/* Reverse: a*b*e -> a*b*e */
Reverse : q0 -> q0.
%ENDT