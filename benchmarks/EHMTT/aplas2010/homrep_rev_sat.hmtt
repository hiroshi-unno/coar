%BEGING
A xa xb z -> xa z.
B xa xb z -> xb z.
Empty xa xb z -> z.
Concat s1 s2 xa xb z -> s1 xa xb (s2 xa xb z).
I2Str x xa xb z -> 
	case x of e => Empty xa xb z
	| a y => Concat A (I2Str y) xa xb z
	| b y => Concat B (I2Str y) xa xb z
.
Str2O s -> s a b e.
Hom sa sb s xa xb z -> s (sa xa xb) (sb xa xb) z.
H s xa xb z -> Hom (Concat B B) A s xa xb z.
F n h x -> 
	case n of z => Rev (coerce qAB (Str2O x)) e
	| s k => F k h (h x) 
.
Rev x z ->
	case x of
	  e => z
	| a y => Rev y (a z)
	| b y => Rev y (b z)
.

HomRepRev n s -> F n H (I2Str s).

%ENDG

%BEGINA
qEven z -> .
qEven s -> qOdd.
qOdd s -> qEven.

/* a*b*e */
qAB a -> qAB.
qAB b -> qB.
qAB e -> .
qB b -> qB.
qB e -> .

/* b*a*e */
qBA b -> qBA.
qBA a -> qA.
qBA e -> .
qA a -> qA.
qA e -> .


%ENDA

%BEGINT
HomRepRev : qEven -> qAB -> qBA.
%ENDT
