// Every run reaches location 2 again after counting x down: every run visits the BUCHI location infinitely
// often.  Expected: YES (-p ltsbuchi), YES (-p ltsexbuchi).
START: 1;
BUCHI: {2};
PRE: {x>=0};

FROM: 1;
assume(x>0);
x := x - 1;
TO: 1;

FROM: 1;
assume(x<=0);
x := 10;
TO: 2;

FROM: 2;
TO: 1;
