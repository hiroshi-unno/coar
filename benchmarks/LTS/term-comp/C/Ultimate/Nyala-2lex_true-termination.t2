///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
var__temp_vx.0 := nondef.0;
var__temp_vy.0 := nondef.1;
TO: main_bb1;

FROM: main_bb1;
vx.0 := var__temp_vx.0;
vy.0 := var__temp_vy.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(vx.0 sge 0);
TO: main_bb2;

FROM: main_bb1_end;
assume(vx.0 slt 0);
TO: main_bb5;

FROM: main_bb2;
v1 := vy.0 - 1;
var__temp_vx.1 := vx.0;
var__temp_vy.1 := v1;
TO: main_bb2_end;

FROM: main_bb2_end;
assume(v1 slt 0);
TO: main_bb3;

FROM: main_bb2_end;
assume(v1 sge 0);
var__temp_vx.1 := vx.0;
var__temp_vy.1 := v1;
TO: main_bb4;

FROM: main_bb3;
v3 := vx.0 - 1;
v4 := nondet();
var__temp_vx.1 := v3;
var__temp_vy.1 := v4;
var__temp_vx.1 := v3;
var__temp_vy.1 := v4;
TO: main_bb4;

FROM: main_bb4;
vx.1 := var__temp_vx.1;
vy.1 := var__temp_vy.1;
var__temp_vx.0 := vx.1;
var__temp_vy.0 := vy.1;
TO: main_bb4_end;

FROM: main_bb4_end;
assume(vy.1 slt 0);
TO: main_bb5;

FROM: main_bb4_end;
assume(vy.1 sge 0);
var__temp_vx.0 := vx.1;
var__temp_vy.0 := vy.1;
TO: main_bb1;

FROM: main_bb5;
TO: main_bb5_ret;

