///*** 1_main ***///
START: main_bb1;
FROM: main_bb1;
memory0_freeIndex := 1;
vmemory0 := nondet();
v3 := memory0_freeIndex;
v4 := memory0_freeIndex;
v5 := v4 + 1;
memory0_freeIndex := v5;
v6 := memory0_freeIndex;
v7 := memory0_freeIndex;
v8 := v7 + 1;
memory0_freeIndex := v8;
v9 := sign_extend(32, 64, v6);
v10 := v9;
vmemory0 := store_array(vmemory0, v9, 1);
v11 := sign_extend(32, 64, v3);
v12 := v11;
vmemory0 := store_array(vmemory0, v11, 10000);
v13 := sign_extend(32, 64, v3);
v14 := v13;
v15 := sign_extend(32, 64, v6);
v16 := v15;
v17 := sign_extend(32, 64, v6);
v18 := v17;
v19 := sign_extend(32, 64, v3);
v20 := v19;
TO: main_bb2;

FROM: main_bb2;
v21 := select_array(vmemory0, v13);
v22 := select_array(vmemory0, v15);
v23 := v21 - v22;
TO: main_bb2_end;

FROM: main_bb2_end;
assume(v23 sge 1);
TO: main_bb3;

FROM: main_bb2_end;
assume(v23 slt 1);
TO: main_bb4;

FROM: main_bb3;
v25 := select_array(vmemory0, v17);
v26 := v25 + 1;
vmemory0 := store_array(vmemory0, v17, v26);
v27 := select_array(vmemory0, v19);
v28 := v27 + -1;
vmemory0 := store_array(vmemory0, v19, v28);
TO: main_bb2;

FROM: main_bb4;
TO: main_bb4_ret;

