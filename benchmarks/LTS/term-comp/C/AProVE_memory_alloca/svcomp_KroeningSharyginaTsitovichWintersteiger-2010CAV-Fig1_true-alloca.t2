///*** 1_main ***///
START: main_bb1;
FROM: main_bb1;
memory0_freeIndex := 1;
vmemory0 := nondet();
v3 := memory0_freeIndex;
v4 := memory0_freeIndex;
v5 := v4 + 1;
memory0_freeIndex := v5;
v6 := memory0_freeIndex;
v7 := memory0_freeIndex;
v8 := v7 + 1;
memory0_freeIndex := v8;
v9 := nondet();
v10 := sign_extend(32, 64, v3);
v11 := v10;
vmemory0 := store_array(vmemory0, v10, v9);
v12 := sign_extend(32, 64, v6);
v13 := v12;
vmemory0 := store_array(vmemory0, v12, 0);
v14 := sign_extend(32, 64, v3);
v15 := v14;
v16 := sign_extend(32, 64, v3);
v17 := v16;
v18 := sign_extend(32, 64, v3);
v19 := v18;
v20 := sign_extend(32, 64, v6);
v21 := v20;
v22 := sign_extend(32, 64, v3);
v23 := v22;
v24 := sign_extend(32, 64, v3);
v25 := v24;
TO: main_bb2;

FROM: main_bb2;
v26 := select_array(vmemory0, v14);
TO: main_bb2_end;

