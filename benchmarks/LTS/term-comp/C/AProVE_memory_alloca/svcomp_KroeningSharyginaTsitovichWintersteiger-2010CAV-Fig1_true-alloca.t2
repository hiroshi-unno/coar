TO: main_bb5;

FROM: main_bb4;
v31 := select_array(vmemory0, v18);
v32 := v31 + -1;
vmemory0 := store_array(vmemory0, v18, v32);
TO: main_bb6;

FROM: main_bb5;
v33 := select_array(vmemory0, v24);
v34 := v33 + 2;
vmemory0 := store_array(vmemory0, v24, v34);
TO: main_bb6;

