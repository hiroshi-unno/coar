///*** 1_main ***///
START: main_bb1;
FROM: main_bb1;
memory0_freeIndex := 1;
vmemory0 := nondet();
v3 := memory0_freeIndex;
v4 := memory0_freeIndex;
v5 := v4 + 1;
memory0_freeIndex := v5;
v6 := memory0_freeIndex;
v7 := memory0_freeIndex;
v8 := v7 + 1;
memory0_freeIndex := v8;
v9 := sign_extend(32, 64, v3);
v10 := v9;
v11 := sign_extend(32, 64, v6);
v12 := v11;
v13 := sign_extend(32, 64, v6);
v14 := v13;
v15 := sign_extend(32, 64, v6);
v16 := v15;
v17 := sign_extend(32, 64, v6);
v18 := v17;
TO: main_bb2;

FROM: main_bb2;
v19 := select_array(vmemory0, v9);
TO: main_bb2_end;

FROM: main_bb2_end;
assume(v19 sle 10);
TO: main_bb3;

