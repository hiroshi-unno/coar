///*** 1_main ***///
START: main_bb1;
FROM: main_bb1;
memory0_freeIndex := 1;
vmemory0 := nondet();
v3 := memory0_freeIndex;
v4 := memory0_freeIndex;
v5 := v4 + 1;
memory0_freeIndex := v5;
v6 := memory0_freeIndex;
v7 := memory0_freeIndex;
v8 := v7 + 1;
memory0_freeIndex := v8;
v9 := memory0_freeIndex;
v10 := memory0_freeIndex;
v11 := v10 + 1;
memory0_freeIndex := v11;
v12 := memory0_freeIndex;
v13 := v12 + 1;
memory0_freeIndex := v13;
v14 := memory0_freeIndex;
v15 := v14 + 1;
memory0_freeIndex := v15;
v16 := nondet();
v18 := sign_extend(32, 64, v3);
v19 := v18;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(v16 != 0);
TO: main_bb2;

FROM: main_bb1_end;
assume(v16 == 0);
TO: main_bb3;

FROM: main_bb2;
vmemory0 := store_array(vmemory0, v18, 1);
TO: main_bb4;

FROM: main_bb3;
vmemory0 := store_array(vmemory0, v18, -1);
