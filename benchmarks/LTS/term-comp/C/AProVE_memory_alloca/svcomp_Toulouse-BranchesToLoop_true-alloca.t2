FROM: main_bb7;
v40 := select_array(vmemory0, v24);
v41 := select_array(vmemory0, v26);
v42 := v40 + v41;
vmemory0 := store_array(vmemory0, v28, v42);
v43 := select_array(vmemory0, v30);
v44 := select_array(vmemory0, v32);
v45 := v43 - v44;
vmemory0 := store_array(vmemory0, v34, v45);
TO: main_bb5;

FROM: main_critedge;
TO: main_critedge_ret;

