FROM: main_bb4;
v20 := sign_extend(32, 64, v6);
v21 := v20;
v22 := sign_extend(32, 64, v9);
v23 := v22;
v24 := sign_extend(32, 64, v6);
v25 := v24;
v26 := sign_extend(32, 64, v3);
v27 := v26;
v28 := sign_extend(32, 64, v6);
v29 := v28;
v30 := sign_extend(32, 64, v9);
v31 := v30;
v32 := sign_extend(32, 64, v3);
v33 := v32;
v34 := sign_extend(32, 64, v9);
v35 := v34;
TO: main_bb5;

FROM: main_bb5;
v36 := select_array(vmemory0, v20);
TO: main_bb5_end;

FROM: main_bb5_end;
assume(v36 slt 100);
TO: main_bb6;

FROM: main_bb5_end;
assume(v36 sge 100);
TO: main_critedge;

FROM: main_bb6;
v38 := select_array(vmemory0, v22);
TO: main_bb6_end;

FROM: main_bb6_end;
assume(v38 slt 100);
TO: main_bb7;

