///*** 1_main ***///
START: main_bb5;
FROM: main_bb5;
memory0_freeIndex := 1;
vmemory0 := nondet();
v30 := nondet();
v31 := memory0_freeIndex;
v32 := memory0_freeIndex;
v33 := v32 + 1;
memory0_freeIndex := v33;
v34 := memory0_freeIndex;
v35 := memory0_freeIndex;
v36 := v35 + 1;
memory0_freeIndex := v36;
v37 := sign_extend(32, 64, v31);
v38 := v37;
vmemory0 := store_array(vmemory0, v37, v30);
v39 := sign_extend(32, 64, v34);
v40 := v39;
vmemory0 := store_array(vmemory0, v39, 0);
v41 := sign_extend(32, 64, v31);
v42 := v41;
v43 := sign_extend(32, 64, v31);
v44 := v43;
v45 := sign_extend(32, 64, v31);
v46 := v45;
v47 := sign_extend(32, 64, v34);
v48 := v47;
TO: main_bb6;

