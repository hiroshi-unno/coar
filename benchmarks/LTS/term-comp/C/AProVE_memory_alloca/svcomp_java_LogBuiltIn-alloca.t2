FROM: main_bb6_end;
assume(v49 sgt 1);
TO: main_bb7;

FROM: main_bb6_end;
assume(v49 sle 1);
TO: main_mlogexit;

FROM: main_bb7;
v51 := select_array(vmemory0, v43);
v52 := v51 sdiv 2;
