///*** 1_main ***///
START: main_bb1;
FROM: main_bb1;
memory0_freeIndex := 1;
vmemory0 := nondet();
v3 := memory0_freeIndex;
v4 := memory0_freeIndex;
v5 := v4 + 1;
memory0_freeIndex := v5;
v6 := memory0_freeIndex;
v7 := memory0_freeIndex;
v8 := v7 + 1;
memory0_freeIndex := v8;
v9 := sign_extend(32, 64, v3);
v10 := v9;
vmemory0 := store_array(vmemory0, v9, 0);
v11 := sign_extend(32, 64, v6);
v12 := v11;
vmemory0 := store_array(vmemory0, v11, 0);
v13 := sign_extend(32, 64, v3);
v14 := v13;
v15 := sign_extend(32, 64, v3);
v16 := v15;
v17 := sign_extend(32, 64, v6);
v18 := v17;
TO: main_bb2;

FROM: main_bb2;
v19 := select_array(vmemory0, v13);
TO: main_bb2_end;

FROM: main_bb2_end;
assume(v19 sgt 10);
TO: main_bb3;

FROM: main_bb2_end;
assume(v19 sle 10);
TO: main_bb4;

FROM: main_bb3;
v21 := sign_extend(32, 64, v6);
v22 := v21;
v23 := select_array(vmemory0, v21);
TO: main_bb3_ret;

FROM: main_bb4;
v24 := select_array(vmemory0, v15);
v25 := v24 + 1;
vmemory0 := store_array(vmemory0, v15, v25);
v26 := select_array(vmemory0, v17);
v27 := v26 + 1;
vmemory0 := store_array(vmemory0, v17, v27);
TO: main_bb2;

