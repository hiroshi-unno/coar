///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
TO: main_bb0_end;

FROM: main_bb0_end;
assume(v0 slt 0);
TO: main_leexit;

FROM: main_bb0_end;
assume(v0 sge 0);
TO: main_bb1;

FROM: main_bb1;
v2 := nondet();
TO: main_bb1_end;

FROM: main_bb1_end;
assume(v2 slt 0);
TO: main_leexit;

FROM: main_bb1_end;
assume(v2 sge 0);
TO: main_bb2;

FROM: main_bb2;
v4 := nondet();
var__temp_vx.tr.i := v0;
var__temp_vy.tr.i := v2;
var__temp_vx.tr.i := v0;
var__temp_vy.tr.i := v2;
TO: main_tailrecursei;

FROM: main_tailrecursei;
vx.tr.i := var__temp_vx.tr.i;
vy.tr.i := var__temp_vy.tr.i;
TO: main_tailrecursei_end;

FROM: main_tailrecursei_end;
assume((vx.tr.i sgt 0) && (vy.tr.i sgt 0));
TO: main_bb3;

FROM: main_tailrecursei_end;
assume((vx.tr.i sle 0) || (vy.tr.i sle 0));
TO: main_leexit;

FROM: main_bb3;
v7 := vx.tr.i - 1;
v8 := vy.tr.i - 1;
var__temp_vx.tr.i := v7;
var__temp_vy.tr.i := v8;
var__temp_vx.tr.i := v7;
var__temp_vy.tr.i := v8;
TO: main_tailrecursei;

FROM: main_leexit;
TO: main_leexit_ret;

