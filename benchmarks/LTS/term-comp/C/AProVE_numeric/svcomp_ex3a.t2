///*** 1_main ***///
START: main_bb4;
FROM: main_bb4;
v4 := nondet();
var__temp_vc.0.i := 0;
var__temp_v.0.i := v4;
var__temp_vc.0.i := 0;
var__temp_v.0.i := v4;
TO: main_bb5;

FROM: main_bb5;
vc.0.i := var__temp_vc.0.i;
v.0.i := var__temp_v.0.i;
TO: main_bb5_end;

FROM: main_bb5_end;
assume((v.0.i sgt 1) && (v.0.i slt 100));
TO: main_bb6;

FROM: main_bb5_end;
assume((v.0.i sle 1) || (v.0.i sge 100));
TO: main_test_funexit;

FROM: main_bb6;
v7 := v.0.i * v.0.i;
v8 := vc.0.i + 1;
var__temp_vc.0.i := v8;
var__temp_v.0.i := v7;
var__temp_vc.0.i := v8;
