///*** 1_main ***///
START: main_bb4;
FROM: main_bb4;
v6 := nondet();
v7 := nondet();
var__temp_vc.0.i := 0;
var__temp_v.01.i := v7;
var__temp_v.0.i := v6;
var__temp_vc.0.i := 0;
var__temp_v.01.i := v7;
var__temp_v.0.i := v6;
TO: main_bb5;

FROM: main_bb5;
vc.0.i := var__temp_vc.0.i;
v.01.i := var__temp_v.01.i;
v.0.i := var__temp_v.0.i;
TO: main_bb5_end;

FROM: main_bb5_end;
assume(!(v.0.i == v.01.i));
TO: main_bb6;

FROM: main_bb5_end;
assume(v.0.i == v.01.i);
TO: main_test_funexit;

FROM: main_bb6;
v11 := v.01.i + 1;
v12 := v.0.i + 1;
TO: main_bb6_v.12.i;
FROM: main_bb6_v.12.i;
assume(v.0.i sgt v.01.i);
v.12.i := v11;
TO: main_bb6_sv.12.i;

FROM: main_bb6_v.12.i;
assume(v.0.i sle v.01.i);
v.12.i := v.01.i;
TO: main_bb6_sv.12.i;

FROM: main_bb6_sv.12.i;
TO: main_bb6_v.1.i;
FROM: main_bb6_v.1.i;
assume(v.0.i sgt v.01.i);
v.1.i := v.0.i;
TO: main_bb6_sv.1.i;

FROM: main_bb6_v.1.i;
assume(v.0.i sle v.01.i);
v.1.i := v12;
TO: main_bb6_sv.1.i;

FROM: main_bb6_sv.1.i;
v13 := vc.0.i + 1;
var__temp_vc.0.i := v13;
var__temp_v.01.i := v.12.i;
var__temp_v.0.i := v.1.i;
var__temp_vc.0.i := v13;
var__temp_v.01.i := v.12.i;
var__temp_v.0.i := v.1.i;
TO: main_bb5;

FROM: main_test_funexit;
TO: main_test_funexit_ret;

