///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
TO: main_bb0_end;

FROM: main_bb0_end;
assume(v0 slt 0);
TO: main_logexit;

FROM: main_bb0_end;
assume(v0 sge 0);
TO: main_bb1;

FROM: main_bb1;
v2 := nondet();
TO: main_bb1_end;

FROM: main_bb1_end;
assume(v2 slt 0);
TO: main_logexit;

FROM: main_bb1_end;
assume(v2 sge 0);
TO: main_bb2;

FROM: main_bb2;
v4 := nondet();
var__temp_vaccumulator.tr.i := 0;
var__temp_vx.tr.i := v0;
var__temp_vaccumulator.tr.i := 0;
var__temp_vx.tr.i := v0;
TO: main_tailrecursei;

FROM: main_tailrecursei;
vaccumulator.tr.i := var__temp_vaccumulator.tr.i;
vx.tr.i := var__temp_vx.tr.i;
TO: main_tailrecursei_end;

FROM: main_tailrecursei_end;
assume((vx.tr.i sge v2) && (v2 sgt 1));
TO: main_bb3;

FROM: main_tailrecursei_end;
assume((vx.tr.i slt v2) || (v2 sle 1));
TO: main_logexit;

FROM: main_bb3;
v7 := vx.tr.i sdiv v2;
v8 := 1 + vaccumulator.tr.i;
var__temp_vaccumulator.tr.i := v8;
var__temp_vx.tr.i := v7;
var__temp_vaccumulator.tr.i := v8;
var__temp_vx.tr.i := v7;
TO: main_tailrecursei;

FROM: main_logexit;
TO: main_logexit_ret;

