///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
v1 := nondet();
v2 := nondet();
v3 := nondet();
v5 := 0 - v3;
TO: main_bb0_v.0.i;
FROM: main_bb0_v.0.i;
assume(v3 slt 0);
v.0.i := v5;
TO: main_bb0_sv.0.i;

FROM: main_bb0_v.0.i;
assume(v3 sge 0);
v.0.i := v3;
TO: main_bb0_sv.0.i;

FROM: main_bb0_sv.0.i;
v6 := nondet();
v8 := 0 - v6;
TO: main_bb0_v.0.i1;
FROM: main_bb0_v.0.i1;
assume(v6 slt 0);
v.0.i1 := v8;
TO: main_bb0_sv.0.i1;

FROM: main_bb0_v.0.i1;
assume(v6 sge 0);
v.0.i1 := v6;
TO: main_bb0_sv.0.i1;

FROM: main_bb0_sv.0.i1;
var__temp_va.tr.i := v.0.i;
var__temp_vb.tr.i := v.0.i1;
var__temp_va.tr.i := v.0.i;
var__temp_vb.tr.i := v.0.i1;
TO: main_tailrecursei;

FROM: main_tailrecursei;
va.tr.i := var__temp_va.tr.i;
vb.tr.i := var__temp_vb.tr.i;
TO: main_tailrecursei_end;

FROM: main_tailrecursei_end;
assume(vb.tr.i sgt 0);
TO: main_bb1;

FROM: main_tailrecursei_end;
assume(vb.tr.i sle 0);
TO: main_loopexit;

FROM: main_bb1;
v10 := nondet();
v12 := 0 - v10;
TO: main_bb1_v.0.i.i;
FROM: main_bb1_v.0.i.i;
assume(v10 slt 0);
v.0.i.i := v12;
TO: main_bb1_sv.0.i.i;

FROM: main_bb1_v.0.i.i;
assume(v10 sge 0);
v.0.i.i := v10;
TO: main_bb1_sv.0.i.i;

FROM: main_bb1_sv.0.i.i;
v13 := va.tr.i - 1;
v14 := v13 - v.0.i.i;
v15 := va.tr.i - 1;
v16 := v15 - v.0.i.i;
var__temp_va.tr.i := v16;
var__temp_vb.tr.i := v14;
var__temp_va.tr.i := v16;
var__temp_vb.tr.i := v14;
TO: main_tailrecursei;

FROM: main_loopexit;
TO: main_loopexit_ret;

