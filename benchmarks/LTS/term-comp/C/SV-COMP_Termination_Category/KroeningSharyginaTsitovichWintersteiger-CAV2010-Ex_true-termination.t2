///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
var__temp_vi.0 := v0;
var__temp_vi.0 := v0;
TO: main_bb1;

FROM: main_bb1;
vi.0 := var__temp_vi.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(vi.0 slt 255);
TO: main_bb2;

FROM: main_bb1_end;
assume(vi.0 sge 255);
TO: main_bb3;

FROM: main_bb2;
v2 := nondet();
v4 := vi.0 + 1;
v5 := vi.0 + 2;
TO: main_bb2_vi.1;
FROM: main_bb2_vi.1;
assume(v2 != 0);
vi.1 := v4;
TO: main_bb2_svi.1;

FROM: main_bb2_vi.1;
assume(v2 == 0);
vi.1 := v5;
TO: main_bb2_svi.1;

FROM: main_bb2_svi.1;
var__temp_vi.0 := vi.1;
var__temp_vi.0 := vi.1;
TO: main_bb1;

FROM: main_bb3;
TO: main_bb3_ret;

