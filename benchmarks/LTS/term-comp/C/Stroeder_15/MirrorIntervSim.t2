///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
var__temp_vi.0 := v0;
var__temp_vi.0 := v0;
TO: main_bb1;

FROM: main_bb1;
vi.0 := var__temp_vi.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(vi.0 != 0);
TO: main_bb2;

FROM: main_bb1_end;
assume(vi.0 == 0);
TO: main_bb5;

FROM: main_bb2;
var__temp_vi.0 := 0;
TO: main_bb2_end;

FROM: main_bb2_end;
assume((-5 sle vi.0) && (vi.0 sle 35));
TO: main_bb3;

FROM: main_bb2_end;
assume((-5 sgt vi.0) || (vi.0 sgt 35));
