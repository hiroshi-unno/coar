TO: main_bb3_end;

FROM: main_bb3_end;
assume(vi.0 slt 0);
var__temp_vi.0 := -5;
TO: main_bb1;

FROM: main_bb3_end;
assume(vi.0 sge 0);
TO: main_bb4;

FROM: main_bb4;
v6 := vi.0 - 1;
TO: main_bb4_vi.1;
FROM: main_bb4_vi.1;
assume(vi.0 sgt 30);
vi.1 := 35;
TO: main_bb4_svi.1;

FROM: main_bb4_vi.1;
