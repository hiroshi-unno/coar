///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
var__temp_vi.0 := 0;
var__temp_vc.0 := 0;
var__temp_vi.0 := 0;
var__temp_vc.0 := 0;
TO: main_bb1;

FROM: main_bb1;
vi.0 := var__temp_vi.0;
vc.0 := var__temp_vc.0;
var__temp_vj.0 := 5;
var__temp_vc.1 := vc.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(vi.0 slt 100);
TO: main_bb2;

FROM: main_bb1_end;
assume(vi.0 sge 100);
var__temp_vj.0 := 5;
var__temp_vc.1 := vc.0;
TO: main_bb3;

FROM: main_bb2;
v1 := vc.0 + 1;
v2 := vi.0 + 1;
var__temp_vi.0 := v2;
var__temp_vc.0 := v1;
var__temp_vi.0 := v2;
var__temp_vc.0 := v1;
TO: main_bb1;

FROM: main_bb3;
vj.0 := var__temp_vj.0;
vc.1 := var__temp_vc.1;
TO: main_bb3_end;

FROM: main_bb3_end;
assume(vj.0 slt 21);
TO: main_bb4;

FROM: main_bb3_end;
assume(vj.0 sge 21);
TO: main_bb5;

FROM: main_bb4;
v4 := vc.1 + 1;
v5 := vj.0 + 3;
var__temp_vj.0 := v5;
var__temp_vc.1 := v4;
var__temp_vj.0 := v5;
var__temp_vc.1 := v4;
TO: main_bb3;

FROM: main_bb5;
TO: main_bb5_ret;

