///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
v1 := nondet();
var__temp_vx.0 := v0;
var__temp_vx.0 := v0;
TO: main_bb1;

FROM: main_bb1;
vx.0 := var__temp_vx.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume((vx.0 sgt 0) && (v1 sgt 0));
TO: main_bb2;

FROM: main_bb1_end;
assume((vx.0 sle 0) || (v1 sle 0));
TO: main_bb3;

FROM: main_bb2;
v4 := 10 * v1;
v5 := 2 * vx.0;
v6 := v4 - v5;
var__temp_vx.0 := v6;
var__temp_vx.0 := v6;
TO: main_bb1;

FROM: main_bb3;
TO: main_bb3_ret;

