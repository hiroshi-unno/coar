///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
var__temp_vx.0 := v0;
var__temp_vx.0 := v0;
var__temp_voldx.0 := nondef.1;
TO: main_bb1;

FROM: main_bb1;
vx.0 := var__temp_vx.0;
voldx.0 := var__temp_voldx.0;
v2 := 2 * vx.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume((vx.0 sgt 1) && (v2 sle voldx.0));
TO: main_bb2;

FROM: main_bb1_end;
assume((vx.0 sle 1) || (v2 sgt voldx.0));
TO: main_critedge;

FROM: main_bb2;
v4 := nondet();
var__temp_vx.0 := v4;
var__temp_voldx.0 := vx.0;
var__temp_vx.0 := v4;
var__temp_voldx.0 := vx.0;
TO: main_bb1;

FROM: main_critedge;
TO: main_critedge_ret;

