///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
v1 := nondet();
var__temp_vy.0 := v1;
var__temp_vres.0 := 0;
var__temp_vy.0 := v1;
var__temp_vres.0 := 0;
TO: main_bb1;

FROM: main_bb1;
vy.0 := var__temp_vy.0;
vres.0 := var__temp_vres.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(v0 sgt vy.0);
TO: main_bb2;

FROM: main_bb1_end;
assume(v0 sle vy.0);
TO: main_bb3;

FROM: main_bb2;
v3 := v0 + 1;
v4 := vres.0 + 1;
var__temp_vy.0 := v3;
var__temp_vres.0 := v4;
var__temp_vy.0 := v3;
var__temp_vres.0 := v4;
TO: main_bb1;

FROM: main_bb3;
TO: main_bb3_ret;

