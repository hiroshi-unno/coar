///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
v1 := nondet();
var__temp_vc.0 := 0;
var__temp_vy.0 := v1;
var__temp_vc.0 := 0;
var__temp_vy.0 := v1;
TO: main_bb1;

FROM: main_bb1;
vc.0 := var__temp_vc.0;
vy.0 := var__temp_vy.0;
v2 := vy.0 + 1;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(v0 sge v2);
TO: main_bb2;

FROM: main_bb1_end;
assume(v0 slt v2);
TO: main_bb3;

FROM: main_bb2;
v4 := vy.0 + 1;
v5 := vc.0 + 1;
var__temp_vc.0 := v5;
var__temp_vy.0 := v4;
var__temp_vc.0 := v5;
var__temp_vy.0 := v4;
TO: main_bb1;

FROM: main_bb3;
TO: main_bb3_ret;

