///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
v1 := nondet();
var__temp_vx.0 := v0;
var__temp_vy.0 := v1;
var__temp_vx.0 := v0;
var__temp_vy.0 := v1;
TO: main_bb1;

FROM: main_bb1;
vx.0 := var__temp_vx.0;
vy.0 := var__temp_vy.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume((vx.0 sge 0) || (vy.0 sge 0));
TO: main_bb2;

FROM: main_bb1_end;
assume((vx.0 slt 0) && (vy.0 slt 0));
TO: main_bb3;

FROM: main_bb2;
v5 := vx.0 - 1;
v6 := vy.0 - 1;
TO: main_bb2_vx.1;
FROM: main_bb2_vx.1;
assume(vx.0 sge 0);
vx.1 := v5;
TO: main_bb2_svx.1;

FROM: main_bb2_vx.1;
assume(vx.0 slt 0);
vx.1 := vx.0;
TO: main_bb2_svx.1;

FROM: main_bb2_svx.1;
TO: main_bb2_vy.1;
FROM: main_bb2_vy.1;
assume(vx.0 sge 0);
vy.1 := vy.0;
TO: main_bb2_svy.1;

FROM: main_bb2_vy.1;
assume(vx.0 slt 0);
vy.1 := v6;
TO: main_bb2_svy.1;

FROM: main_bb2_svy.1;
var__temp_vx.0 := vx.1;
var__temp_vy.0 := vy.1;
var__temp_vx.0 := vx.1;
var__temp_vy.0 := vy.1;
TO: main_bb1;

FROM: main_bb3;
TO: main_bb3_ret;

