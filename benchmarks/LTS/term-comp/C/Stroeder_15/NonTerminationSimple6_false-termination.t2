///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
var__temp_vx.0 := v0;
var__temp_vx.0 := v0;
TO: main_bb1;

FROM: main_bb1;
vx.0 := var__temp_vx.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(vx.0 sge 0);
TO: main_bb2;

FROM: main_bb1_end;
assume(vx.0 slt 0);
TO: main_bb3;

FROM: main_bb2;
v2 := vx.0 + 5;
var__temp_vx.0 := v2;
var__temp_vx.0 := v2;
TO: main_bb1;

FROM: main_bb3;
TO: main_bb3_ret;

