///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
var__temp_vlife.0 := 13;
var__temp_vdeath.0 := 17;
var__temp_vlife.0 := 13;
var__temp_vdeath.0 := 17;
TO: main_bb1;

FROM: main_bb1;
vlife.0 := var__temp_vlife.0;
vdeath.0 := var__temp_vdeath.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(vlife.0 slt vdeath.0);
TO: main_bb2;

FROM: main_bb1_end;
assume(vlife.0 sge vdeath.0);
TO: main_bb3;

FROM: main_bb2;
v1 := vlife.0 + 1;
TO: main_bb2_vlife.1;
FROM: main_bb2_vlife.1;
assume((2 slt vdeath.0) || (2 slt v1));
vlife.1 := 2;
TO: main_bb2_svlife.1;

FROM: main_bb2_vlife.1;
assume((2 sge vdeath.0) && (2 sge v1));
vlife.1 := vdeath.0;
TO: main_bb2_svlife.1;

FROM: main_bb2_svlife.1;
var__temp_vlife.0 := vlife.1;
var__temp_vdeath.0 := v1;
var__temp_vlife.0 := vlife.1;
var__temp_vdeath.0 := v1;
TO: main_bb1;

FROM: main_bb3;
TO: main_bb3_ret;

