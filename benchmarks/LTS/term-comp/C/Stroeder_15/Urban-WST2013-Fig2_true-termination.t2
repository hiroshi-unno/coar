///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
v1 := nondet();
var__temp_vx1.0 := v0;
var__temp_vx1.0 := v0;
TO: main_bb1;

FROM: main_bb1;
vx1.0 := var__temp_vx1.0;
var__temp_vx2.0 := 10;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(vx1.0 sle 10);
var__temp_vx2.0 := 10;
TO: main_bb2;

FROM: main_bb1_end;
assume(vx1.0 sgt 10);
TO: main_bb5;

FROM: main_bb2;
vx2.0 := var__temp_vx2.0;
TO: main_bb2_end;

FROM: main_bb2_end;
assume(vx2.0 sgt 1);
TO: main_bb3;

FROM: main_bb2_end;
assume(vx2.0 sle 1);
TO: main_bb4;

FROM: main_bb3;
v4 := vx2.0 - 1;
var__temp_vx2.0 := v4;
var__temp_vx2.0 := v4;
TO: main_bb2;

FROM: main_bb4;
v5 := vx1.0 + 1;
var__temp_vx1.0 := v5;
var__temp_vx1.0 := v5;
TO: main_bb1;

FROM: main_bb5;
TO: main_bb5_ret;

