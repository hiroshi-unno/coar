///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
v1 := nondet();
var__temp_va.0 := v0;
var__temp_vb.0 := v1;
var__temp_va.0 := v0;
var__temp_vb.0 := v1;
TO: main_bb1;

FROM: main_bb1;
va.0 := var__temp_va.0;
vb.0 := var__temp_vb.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume((va.0 sge 1) && (vb.0 sge 1));
TO: main_bb2;

FROM: main_bb1_end;
assume((va.0 slt 1) || (vb.0 slt 1));
TO: main_bb3;

FROM: main_bb2;
v4 := 2 * va.0;
v5 := 3 * vb.0;
var__temp_va.0 := v4;
var__temp_vb.0 := v5;
var__temp_va.0 := v4;
var__temp_vb.0 := v5;
TO: main_bb1;

FROM: main_bb3;
TO: main_bb3_ret;

