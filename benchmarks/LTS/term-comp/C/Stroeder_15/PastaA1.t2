///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
var__temp_vx.0 := v0;
var__temp_vx.0 := v0;
TO: main_bb1;

FROM: main_bb1;
vx.0 := var__temp_vx.0;
var__temp_vy.0 := 0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(vx.0 sgt 0);
var__temp_vy.0 := 0;
TO: main_bb2;

FROM: main_bb1_end;
assume(vx.0 sle 0);
TO: main_bb5;

FROM: main_bb2;
vy.0 := var__temp_vy.0;
TO: main_bb2_end;

FROM: main_bb2_end;
assume(vy.0 slt vx.0);
TO: main_bb3;

FROM: main_bb2_end;
assume(vy.0 sge vx.0);
TO: main_bb4;

FROM: main_bb3;
v3 := vy.0 + 1;
var__temp_vy.0 := v3;
var__temp_vy.0 := v3;
TO: main_bb2;

FROM: main_bb4;
v4 := vx.0 - 1;
var__temp_vx.0 := v4;
var__temp_vx.0 := v4;
TO: main_bb1;

FROM: main_bb5;
TO: main_bb5_ret;

