///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
v1 := nondet();
v2 := nondet();
var__temp_vy.0 := v1;
var__temp_vx.0 := v0;
var__temp_vy.0 := v1;
var__temp_vx.0 := v0;
var__temp_voldx.0 := nondef.3;
TO: main_bb1;

FROM: main_bb1;
vy.0 := var__temp_vy.0;
vx.0 := var__temp_vx.0;
voldx.0 := var__temp_voldx.0;
v5 := 2 * voldx.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(((vx.0 sgt 0) && (vx.0 slt vy.0)) && (vx.0 sgt v5));
TO: main_bb2;

FROM: main_bb1_end;
assume(((vx.0 sle 0) || (vx.0 sge vy.0)) || (vx.0 sle v5));
TO: main_critedge;

FROM: main_bb2;
v7 := nondet();
var__temp_vy.0 := v2;
var__temp_vx.0 := v7;
var__temp_voldx.0 := vx.0;
var__temp_vy.0 := v2;
var__temp_vx.0 := v7;
var__temp_voldx.0 := vx.0;
TO: main_bb1;

FROM: main_critedge;
TO: main_critedge_ret;

