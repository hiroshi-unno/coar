///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
v1 := nondet();
var__temp_vc.0 := 0;
var__temp_vx.0 := v0;
var__temp_vc.0 := 0;
var__temp_vx.0 := v0;
TO: main_bb1;

FROM: main_bb1;
vc.0 := var__temp_vc.0;
vx.0 := var__temp_vx.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume((vx.0 sgt 1) && (vx.0 slt v1));
TO: main_bb2;

FROM: main_bb1_end;
assume((vx.0 sle 1) || (vx.0 sge v1));
TO: main_bb3;

FROM: main_bb2;
v4 := vx.0 * vx.0;
v5 := vc.0 + 1;
var__temp_vc.0 := v5;
var__temp_vx.0 := v4;
var__temp_vc.0 := v5;
var__temp_vx.0 := v4;
TO: main_bb1;

FROM: main_bb3;
TO: main_bb3_ret;

