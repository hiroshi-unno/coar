///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
v1 := nondet();
v2 := nondet();
var__temp_vx.0 := v0;
var__temp_vc.0 := 0;
var__temp_vy.0 := v1;
var__temp_vx.0 := v0;
var__temp_vc.0 := 0;
var__temp_vy.0 := v1;
TO: main_bb1;

FROM: main_bb1;
vx.0 := var__temp_vx.0;
vc.0 := var__temp_vc.0;
vy.0 := var__temp_vy.0;
var__temp_vc.1 := vc.0;
var__temp_vy.1 := vy.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(vx.0 sgt v2);
var__temp_vc.1 := vc.0;
var__temp_vy.1 := vy.0;
TO: main_bb2;

FROM: main_bb1_end;
assume(vx.0 sle v2);
TO: main_bb5;

FROM: main_bb2;
vc.1 := var__temp_vc.1;
vy.1 := var__temp_vy.1;
TO: main_bb2_end;

FROM: main_bb2_end;
assume(vy.1 sgt v2);
TO: main_bb3;

FROM: main_bb2_end;
assume(vy.1 sle v2);
TO: main_bb4;

FROM: main_bb3;
v5 := vy.1 - 1;
v6 := vc.1 + 1;
var__temp_vc.1 := v6;
var__temp_vy.1 := v5;
var__temp_vc.1 := v6;
var__temp_vy.1 := v5;
TO: main_bb2;

FROM: main_bb4;
v7 := vc.1 + 1;
v8 := vx.0 - 1;
var__temp_vx.0 := v8;
var__temp_vc.0 := v7;
var__temp_vy.0 := vy.1;
var__temp_vx.0 := v8;
var__temp_vc.0 := v7;
var__temp_vy.0 := vy.1;
TO: main_bb1;

FROM: main_bb5;
TO: main_bb5_ret;

