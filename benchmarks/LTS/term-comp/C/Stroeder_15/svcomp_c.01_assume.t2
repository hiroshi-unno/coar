///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
v1 := nondet();
var__temp_vx.0 := v0;
var__temp_vy.0 := v1;
var__temp_vx.0 := v0;
var__temp_vy.0 := v1;
TO: main_bb1;

FROM: main_bb1;
vx.0 := var__temp_vx.0;
vy.0 := var__temp_vy.0;
var__temp_vy.1 := 1;
TO: main_bb1_end;

FROM: main_bb1_end;
assume((vx.0 sge 0) && (vy.0 sgt 0));
var__temp_vy.1 := 1;
TO: main_bb2;

FROM: main_bb1_end;
assume((vx.0 slt 0) || (vy.0 sle 0));
TO: main_bb5;

FROM: main_bb2;
vy.1 := var__temp_vy.1;
TO: main_bb2_end;

FROM: main_bb2_end;
assume((vx.0 sgt vy.1) && (vy.1 sgt 0));
TO: main_bb3;

FROM: main_bb2_end;
assume((vx.0 sle vy.1) || (vy.1 sle 0));
TO: main_bb4;

FROM: main_bb3;
v7 := 2 * vy.1;
var__temp_vy.1 := v7;
var__temp_vy.1 := v7;
TO: main_bb2;

FROM: main_bb4;
v8 := vx.0 - 1;
var__temp_vx.0 := v8;
var__temp_vy.0 := vy.1;
var__temp_vx.0 := v8;
var__temp_vy.0 := vy.1;
TO: main_bb1;

FROM: main_bb5;
TO: main_bb5_ret;

