///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
v1 := nondet();
var__temp_vc.0 := 0;
var__temp_vx.0 := v0;
TO: main_bb0_end;

FROM: main_bb0_end;
assume(v1 sgt 0);
var__temp_vc.0 := 0;
var__temp_vx.0 := v0;
TO: main_bb1;

FROM: main_bb0_end;
assume(v1 sle 0);
TO: main_bb3;

FROM: main_bb1;
vc.0 := var__temp_vc.0;
vx.0 := var__temp_vx.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(vx.0 sgt 0);
TO: main_bb2;

FROM: main_bb1_end;
assume(vx.0 sle 0);
TO: main_bb3;

FROM: main_bb2;
v5 := vx.0 - 1;
TO: main_bb2_vx.1;
FROM: main_bb2_vx.1;
assume(vx.0 sgt v1);
vx.1 := v1;
TO: main_bb2_svx.1;

FROM: main_bb2_vx.1;
assume(vx.0 sle v1);
vx.1 := v5;
TO: main_bb2_svx.1;

FROM: main_bb2_svx.1;
v6 := vc.0 + 1;
var__temp_vc.0 := v6;
var__temp_vx.0 := vx.1;
var__temp_vc.0 := v6;
var__temp_vx.0 := vx.1;
TO: main_bb1;

FROM: main_bb3;
TO: main_bb3_ret;

