///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
var__temp_vx.0 := v0;
var__temp_vx.0 := v0;
var__temp_voldx.0 := nondef.1;
TO: main_bb1;

FROM: main_bb1;
vx.0 := var__temp_vx.0;
voldx.0 := var__temp_voldx.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume((vx.0 sgt 0) && (vx.0 slt 100));
TO: main_bb2;

FROM: main_bb1_end;
assume((vx.0 sle 0) || (vx.0 sge 100));
TO: main_critedge;

FROM: main_bb2;
v3 := 2 * voldx.0;
v4 := v3 + 10;
TO: main_bb2_end;

FROM: main_bb2_end;
assume(vx.0 sge v4);
TO: main_bb3;

FROM: main_bb2_end;
assume(vx.0 slt v4);
TO: main_critedge;

FROM: main_bb3;
v6 := nondet();
var__temp_vx.0 := v6;
var__temp_voldx.0 := vx.0;
var__temp_vx.0 := v6;
var__temp_voldx.0 := vx.0;
TO: main_bb1;

FROM: main_critedge;
TO: main_critedge_ret;

