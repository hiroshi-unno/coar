///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
v1 := nondet();
var__temp_vi.0 := v0;
var__temp_vj.0 := v1;
var__temp_vi.0 := v0;
var__temp_vj.0 := v1;
TO: main_bb1;

FROM: main_bb1;
vi.0 := var__temp_vi.0;
vj.0 := var__temp_vj.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(vi.0 != vj.0);
TO: main_bb2;

FROM: main_bb1_end;
assume(vi.0 == vj.0);
TO: main_bb3;

FROM: main_bb2;
v3 := vi.0 - 1;
v4 := vj.0 + 1;
var__temp_vi.0 := v3;
var__temp_vj.0 := v4;
var__temp_vi.0 := v3;
var__temp_vj.0 := v4;
TO: main_bb1;

FROM: main_bb3;
TO: main_bb3_ret;

