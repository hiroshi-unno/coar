///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
v1 := nondet();
var__temp_vy.0 := v1;
var__temp_vx.0 := v0;
var__temp_vy.0 := v1;
var__temp_vx.0 := v0;
TO: main_bb1;

FROM: main_bb1;
vy.0 := var__temp_vy.0;
vx.0 := var__temp_vx.0;
var__temp_vxtmp.0 := vx.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume((vy.0 sgt 0) && (vx.0 sgt 0));
var__temp_vxtmp.0 := vx.0;
TO: main_bb2;

FROM: main_bb1_end;
assume((vy.0 sle 0) || (vx.0 sle 0));
TO: main_bb4;

FROM: main_bb2;
vxtmp.0 := var__temp_vxtmp.0;
var__temp_vy.0 := vxtmp.0;
var__temp_vx.0 := vy.0;
TO: main_bb2_end;

FROM: main_bb2_end;
assume((vxtmp.0 sge vy.0) && (vy.0 sgt 0));
TO: main_bb3;

FROM: main_bb2_end;
assume((vxtmp.0 slt vy.0) || (vy.0 sle 0));
var__temp_vy.0 := vxtmp.0;
var__temp_vx.0 := vy.0;
TO: main_bb1;

FROM: main_bb3;
v6 := vxtmp.0 - vy.0;
var__temp_vxtmp.0 := v6;
var__temp_vxtmp.0 := v6;
TO: main_bb2;

FROM: main_bb4;
TO: main_bb4_ret;

