///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
v1 := nondet();
v2 := nondet();
var__temp_vz.0 := v2;
TO: main_bb0_end;

FROM: main_bb0_end;
assume(v1 sgt 0);
var__temp_vz.0 := v2;
TO: main_bb1;

FROM: main_bb0_end;
assume(v1 sle 0);
TO: main_bb3;

FROM: main_bb1;
vz.0 := var__temp_vz.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume(v0 sge vz.0);
TO: main_bb2;

FROM: main_bb1_end;
assume(v0 slt vz.0);
TO: main_bb3;

FROM: main_bb2;
v5 := vz.0 + v1;
var__temp_vz.0 := v5;
var__temp_vz.0 := v5;
TO: main_bb1;

FROM: main_bb3;
TO: main_bb3_ret;

