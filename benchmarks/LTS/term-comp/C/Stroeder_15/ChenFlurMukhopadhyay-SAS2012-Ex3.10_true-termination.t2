///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
v1 := nondet();
v2 := nondet();
var__temp_vx.0 := v0;
var__temp_vy.0 := v1;
var__temp_vx.0 := v0;
var__temp_vy.0 := v1;
TO: main_bb1;

FROM: main_bb1;
vx.0 := var__temp_vx.0;
vy.0 := var__temp_vy.0;
v4 := vx.0 + vy.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume((vx.0 sge 0) && (v4 sge 0));
TO: main_bb2;

FROM: main_bb1_end;
assume((vx.0 slt 0) || (v4 slt 0));
TO: main_critedge;

FROM: main_bb2;
v6 := vx.0 + vy.0;
v7 := v6 + v2;
v8 := 0 - v2;
v9 := v8 - 1;
var__temp_vx.0 := v7;
var__temp_vy.0 := v9;
var__temp_vx.0 := v7;
var__temp_vy.0 := v9;
TO: main_bb1;

FROM: main_critedge;
TO: main_critedge_ret;

