///*** 1_main ***///
START: main_bb0;
FROM: main_bb0;
v0 := nondet();
v1 := nondet();
var__temp_vy.0 := v1;
var__temp_vx.0 := v0;
var__temp_vy.0 := v1;
var__temp_vx.0 := v0;
var__temp_voldy.0 := nondef.2;
TO: main_bb1;

FROM: main_bb1;
vy.0 := var__temp_vy.0;
vx.0 := var__temp_vx.0;
voldy.0 := var__temp_voldy.0;
v3 := 0 - voldy.0;
TO: main_bb1_end;

FROM: main_bb1_end;
assume((vx.0 sgt 0) && (vy.0 sle v3));
TO: main_bb2;

FROM: main_bb1_end;
assume((vx.0 sle 0) || (vy.0 sgt v3));
TO: main_critedge;

FROM: main_bb2;
v5 := nondet();
var__temp_vy.0 := v5;
var__temp_vx.0 := vy.0;
var__temp_voldy.0 := vy.0;
var__temp_vy.0 := v5;
var__temp_vx.0 := vy.0;
var__temp_voldy.0 := vy.0;
TO: main_bb1;

FROM: main_critedge;
TO: main_critedge_ret;

