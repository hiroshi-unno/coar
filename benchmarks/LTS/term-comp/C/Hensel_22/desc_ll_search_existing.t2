FROM: main_bb13;
v32 := memory0_freeIndex;
v33 := memory0_freeIndex;
v34 := v33 + 1;
memory0_freeIndex := v34;
v35 := sign_extend(32, 64, v32);
v36 := select_array(vmemory0, v35);
v37v1 := select_tuple(v36, 1, 2);
v37v2 := constr_tuple(vj.0.i, v37v1);
