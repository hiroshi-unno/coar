[
    "PCSat",
    {
        "preprocessor": [
            "Filename",
            "./config/pcsat/preprocessor/enable_thrust.json"
        ],
        "coordinator": [
            "Filename",
            "./config/pcsat/coordinator/tbq_ar_step_preimages.json"
        ],
        "sol_printer": [
            "Filename",
            "./config/pcsat/sol_printer/enable.json"
        ],
        "probes": {
