                    [
                        "Goal_cone_congruence"
                    ]
                ]
            }
        },
        "reader": {
            "premise_witness_disjuncts": true,
            "fold_inlined_selector_reads": true
        },
        "simplifier": {
            "truth_table_long_sequence_bound": 1000
        },
        "recursive_functions": {
            "definitions": {
                "residual_contexts": [
                    "Residual_clean_pool"
                ]
            }
        }
    }
