opam-version: "2.0"
name: "CoAR"
version: "4.0"
maintainer: "Hiroshi Unno <hiroshi.unno@acm.org>"
authors: "Hiroshi Unno <hiroshi.unno@acm.org>"
homepage: "https://github.com/hiroshi-unno/coar"
bug-reports: "https://github.com/hiroshi-unno/coar/issues"
synopsis: "Collection of Automated Reasoners"
description: ""
pin-depends: [
  ["libsvm.0.10.0~modified" "git+https://github.com/hiroshi-unno/libsvm-ocaml.git"]
]
depends: [
  "ocaml" {>= "5.4.0"}
  "dune" {>= "3.10"}
  "core"
  "core_unix"
  "domainslib"
  "menhir"
  "ppx_deriving_yojson"
  "ppxlib" {build}
  "ocaml-compiler-libs"
  "ocamlgraph"
  "zarith"
  "z3" {>= "5.1.0"}
  "minisat"
  "libsvm" {= "0.10.0~modified"}
  "camlzip"
  "apronext"
]
# Only lib/MIP, lib/MIPSolver and lib/MIPSolver/gurobi need these, and
# lp-gurobi binds a commercial solver, so they cannot be hard dependencies.
# The libraries are marked (optional) in their dune files: without the packages
# `dune build` skips them instead of failing.  lp and lp-glpk (GLPK, free) are
# enough for MIP and MIPSolver; only CoAR.MIPGurobi needs lp-gurobi.
depopts: [
  "lp"
  "lp-glpk"
  "lp-gurobi"
]
build: ["dune" "build"]
